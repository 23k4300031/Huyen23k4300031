<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BIGBANG WORLD TOUR [MADE
] HANOI - VIP Ticketing</title>
    <!-- Thư viện Ethers.js v6 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.7.0/ethers.umd.min.js"></script>
    <!-- Font chữ hiện đại -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #05070c;
            --bg-card: #0e1424;
            --border-color: #1e293b;
            --accent-gold: #f59e0b;
            --accent-glow: rgba(245,
    158,
    11,
    0.25);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --success-color: #10b981;
            --danger-color: #ef4444;
}

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-main);
            margin: 0;
            padding: 40px 20px;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(30,
    27,
    75,
    0.4) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(180,
    83,
    9,
    0.15) 0%, transparent 40%);
            background-attachment: fixed;
}

        .container {
            max-width: 1000px;
            margin: 0 auto;
}
/* Hero Banner Sinh Động */
        .hero {
            background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
            border: 1px solid rgba(245,
    158,
    11,
    0.3);
            border-radius: 24px;
            padding: 45px 30px;
            text-align: center;
            margin-bottom: 30px;
            box-shadow: 0 20px 40px rgba(0,
    0,
    0,
    0.6),
    0 0 30px rgba(245,
    158,
    11,
    0.1);
            position: relative;
            overflow: hidden;
}

        .hero: :before {
            content: '';
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 300px;
            height: 300px;
            background: rgba(245,
    158,
    11,
    0.15);
            border-radius: 50%;
            filter: blur(60px);
            z-index: 0;
}

        .hero > * {
            position: relative;
            z-index: 1;
}

        .badge {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #000;
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(245,
    158,
    11,
    0.4);
}

        .hero h1 {
            margin: 20px 0 10px 0;
            font-size: 38px;
            font-weight: 800;
            background: linear-gradient(to right, #fff, #cbd5e1, #f59e0b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1px;
}

        .hero p {
            color: var(--text-muted);
            font-size: 15px;
            margin: 0;
}
/* Wallet Bar Đẳng Cấp */
        .wallet-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 22px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px rgba(0,
    0,
    0,
    0.3);
            backdrop-filter: blur(10px);
}

        .pulse-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            background-color: var(--success-color);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--success-color);
            animation: pulse 2s infinite;
            margin-right: 8px;
}

        @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16,
        185,
        129,
        0.7);
    }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16,
        185,
        129,
        0);
    }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16,
        185,
        129,
        0);
    }
}
/* Grid Layout */
        .grid-2 {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 25px;
}

        @media (max-width: 768px) {
            .grid-2 {
                grid-template-columns: 1fr;
    }
}

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 12px 30px rgba(0,
    0,
    0,
    0.4);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
}

        .card:hover {
            border-color: rgba(245,
    158,
    11,
    0.4);
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0,
    0,
    0,
    0.5),
    0 0 20px var(--accent-glow);
}

        .card h3 {
            margin-top: 0;
            font-size: 19px;
            color: #fff;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
}
/* Event Info Box */
        .event-perks {
            background: rgba(15,
    23,
    42,
    0.6);
            border: 1px dashed var(--border-color);
            border-radius: 12px;
            padding: 15px;
            margin: 15px 0 20px 0;
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.6;
}

        label {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 600;
}

        input {
            width: 100%;
            padding: 14px 18px;
            background: #03050a;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            color: #fff;
            font-size: 14px;
            box-sizing: border-box;
            margin-bottom: 18px;
            transition: all 0.2s;
}

        input:focus {
            outline: none;
            border-color: var(--accent-gold);
            box-shadow: 0 0 12px var(--accent-glow);
}

        button {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #000;
            border: none;
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 800;
            border-radius: 12px;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(245,
    158,
    11,
    0.3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
}

        button:hover {
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(245,
    158,
    11,
    0.5);
}

        .btn-outline {
            background: transparent;
            color: #fff;
            border: 1px solid rgba(255,
    255,
    255,
    0.2);
            width: auto;
            padding: 10px 20px;
            font-weight: 600;
            box-shadow: none;
            text-transform: none;
}

        .btn-outline:hover {
            background: rgba(255,
    255,
    255,
    0.05);
            border-color: var(--accent-gold);
            color: var(--accent-gold);
            box-shadow: none;
}

        .console-box {
            margin-top: 18px;
            background: #03050a;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 15px;
            font-size: 12px;
            font-family: monospace;
            color: #38bdf8;
            min-height: 28px;
            word-break: break-all;
            line-height: 1.6;
}

        .full-width {
            grid-column: 1 / -1;
}
    </style>
</head>

<body>

    <div class="container">
        <!-- Banner Header -->
        <div class="hero">
            <span class="badge">ĐỀ TÀI 6: HỆ THỐNG VÉ NFT CHỐNG ĐẦU CƠ</span>
            <h1>BIGBANG WORLD TOUR [MADE
] HANOI</h1>
            <p>🎵 Sân vận động Quốc gia Mỹ Đình | Công nghệ Smart Contract & Chống đầu cơ vé độc quyền</p>
        </div>

        <!-- Thanh kết nối ví động -->
        <div class="wallet-card">
            <div>
                <strong style="font-size: 11px; color: var(--text-muted); display: block; margin-bottom: 4px; letter-spacing: 1px;">TRẠNG THÁI KẾT NỐI VÍ</strong>
                <span id="walletAddress" style="font-size: 14px; color: #f3f4f6; font-family: monospace;">Chưa kết nối MetaMask</span>
            </div>
            <button class="btn-outline" onclick="connectWallet()">🔗 Kết nối Ví Web3</button>
        </div>

        <!-- Các tính năng chính -->
        <div class="grid-2">
            <!-- Tính năng 1: Mở bán sơ cấp -->
            <div class="card">
                <h3>🎟️ Mua Vé Sơ Cấp (Mint NFT)</h3>
                <div class="event-perks">
                    ✨ <strong>Đặc quyền vé:</strong> Vé định danh blockchain duy nhất.<br>
                    💰 <strong>Giá niêm yết:</strong> <span style="color: var(--accent-gold); font-weight: 700;">0.05 ETH</span><br>
                    🛡️ <strong>Chính sách:</strong> Giới hạn nghiêm ngặt tối đa <strong>01 vé / ví</strong> ngăn chặn hoàn toàn phe vé.
                </div>
                <button onclick="buyTicket()">Thanh Toán & Nhận Vé Ngay</button>
                <div class="console-box" id="buyLog">⚡ Trạng thái: Chờ kết nối ví blockchain...</div>
            </div>

            <!-- Tính năng 2: Tra cứu thông tin vé -->
            <div class="card">
                <h3>🔍 Tra Cứu Chủ Sở Hữu Vé</h3>
                <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 15px;">
                    Kiểm tra trực tiếp lịch sử và quyền sở hữu minh bạch của bất kỳ mã định danh vé nào trên mạng.
                </p>
                <label>Nhập Token ID của vé:</label>
                <input type="number" id="queryId" placeholder="Ví dụ: 1">
                <button onclick="checkOwner()" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: #fff; box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);">Truy Vấn On-Chain</button>
                <div class="console-box" id="queryLog" style="color: #60a5fa;">🔍 Kết quả truy vấn sẽ hiển thị tại đây...</div>
            </div>

            <!-- Tính năng 3: Soát vé tại cửa (Dành cho BTC) -->
            <div class="card full-width">
                <h3>🛡️ Cổng Kiểm Soát Cửa Vào (Dành cho Ban Tổ Chức)</h3>
                <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 15px;">
                    Quét mã định danh vé tại cổng soát vé sân vận động Mỹ Đình. Hệ thống tự động xác thực và khóa trạng thái vé vĩnh viễn để chống việc tái sử dụng.
                </p>
                <div style="display: flex; gap: 15px;">
                    <input type="number" id="checkinId" placeholder="Nhập Token ID cần soát vé..." style="margin-bottom: 0;">
                    <button onclick="checkInTicket()" style="background: linear-gradient(135deg, #ef4444, #b91c1c); color: #fff; width: 240px; box-shadow: 0 6px 20px rgba(239, 68, 68, 0.3);">Xác Nhận Check-In</button>
                </div>
                <div class="console-box" id="checkinLog" style="color: #f87171; margin-top: 15px;">🛡️ Nhật ký cổng soát vé trống...</div>
            </div>
        </div>
    </div>

    <!-- Script Tương Tác Web3 (Ethers.js v6) -->
    <script>
        // --- ĐỊA CHỈ SMART CONTRACT ĐÃ ĐƯỢC TÍCH HỢP ---
        const CONTRACT_ADDRESS = "0x0E54D73970C0e802585bdB1561370ff1A05286B1";
        
        const CONTRACT_ABI = [
    "function buyTicket() external payable",
    "function ownerOf(uint256 tokenId) view returns (address)",
    "function checkIn(uint256 tokenId) external"
];

        let provider, signer, contract;

        async function connectWallet() {
            if (window.ethereum) {
                try {
                    provider = new ethers.BrowserProvider(window.ethereum);
                    signer = await provider.getSigner();
                    const address = await signer.getAddress();

                    contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);

                    document.getElementById("walletAddress").innerHTML =
                        `<span class="pulse-dot"></span><span style="color: var(--success-color); font-weight: 700;">Đã kết nối: ${address.substring(0,
                6)
            }...${address.substring(38)
            }</span>`;
                    document.getElementById("buyLog").innerText = "⚡ Sẵn sàng thực hiện giao dịch mua vé sự kiện.";
        } catch (error) {
                    alert("Người dùng từ chối kết nối ví!");
        }
    } else {
                alert("Vui lòng cài đặt tiện ích MetaMask trên trình duyệt!");
    }
}

        async function buyTicket() {
            if (!contract) { alert("Vui lòng kết nối ví MetaMask trước!"); return;
    }
            try {
                document.getElementById("buyLog").innerText = "⏳ Đang gửi yêu cầu mua vé lên mạng (0.05 ETH)...";
                const tx = await contract.buyTicket({ value: ethers.parseEther("0.05")
        });
                document.getElementById("buyLog").innerText = `🔗 Đã gửi TX: ${tx.hash
        }. Đang chờ mạng xác nhận...`;
                await tx.wait();
                document.getElementById("buyLog").innerText = "🎉 Giao dịch thành công! Vé NFT BigBang đã được đúc vào ví của bạn.";
    } catch (error) {
                document.getElementById("buyLog").innerText = "❌ Lỗi giao dịch: " + (error.reason || error.message);
    }
}

        async function checkOwner() {
            if (!contract) { alert("Vui lòng kết nối ví MetaMask trước!"); return;
    }
            const tokenId = document.getElementById("queryId").value;
            if (!tokenId) { alert("Vui lòng nhập Token ID cần tra cứu!"); return;
    }
            try {
                document.getElementById("queryLog").innerText = `🔍 Đang truy vấn Smart Contract cho vé #${tokenId
        }...`;
                const owner = await contract.ownerOf(tokenId);
                document.getElementById("queryLog").innerText = `✅ Vé #${tokenId
        } thuộc sở hữu của ví:\n${owner
        }`;
    } catch (error) {
                document.getElementById("queryLog").innerText = "❌ Không tìm thấy thông tin hoặc vé chưa được đúc!";
    }
}

        async function checkInTicket() {
            if (!contract) { alert("Vui lòng kết nối ví MetaMask trước!"); return;
    }
            const tokenId = document.getElementById("checkinId").value;
            if (!tokenId) { alert("Vui lòng nhập Token ID soát vé!"); return;
    }
            try {
                document.getElementById("checkinLog").innerText = `🛡️ Đang thực hiện khóa vé #${tokenId
        } tại cổng soát vé...`;
                const tx = await contract.checkIn(tokenId);
                await tx.wait();
                document.getElementById("checkinLog").innerText = `✅ Check-in thành công cho vé #${tokenId
        }! Vé đã chính thức được khóa trạng thái sử dụng.`;
    } catch (error) {
                document.getElementById("checkinLog").innerText = "❌ Lỗi check-in: " + (error.reason || error.message);
    }
}
    </script>
</body>

</html>